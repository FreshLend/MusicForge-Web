# ==========================================
# Основные настройки сервера
# ==========================================
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0

# Секретный ключ (оставьте пустым, чтобы сервер 
# автоматически сгенерировал файл .secret_key)
# SECRET_KEY=secret_key_here

# ==========================================
# База данных
# ==========================================
# По умолчанию используется SQLite
DATABASE_URI=sqlite:///musicforge.db

# ==========================================
# Загрузка файлов
# ==========================================
MAX_UPLOAD_MB=500

# ==========================================
# Токены и сессии (API)
# ==========================================
# Проверять срок действия токенов (1 - вкл, 0 - выкл)
ENFORCE_TOKEN_EXPIRY=1
ACCESS_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_TTL_DAYS=90

# Устанавливать флаг Secure для cookie 
# (Включайте '1' ТОЛЬКО если сайт работает через HTTPS!)
COOKIE_SECURE=0

# ==========================================
# CORS и защита от брутфорса (Лимиты)
# ==========================================
# Разрешенные домены для API (через запятую, например: https://mysite.com,https://app.mysite.com)
# Оставьте пустым, чтобы разрешить все домены
ALLOWED_ORIGINS=

# Хранилище для лимитов (в памяти).
# Лучше использовать Redis: redis://localhost:6379/0
RATELIMIT_STORAGE_URI=memory://

# ==========================================
# OAuth (Опционально)
# ==========================================
# Раскомментируйте и заполните, если хотите включить вход через Google/GitHub
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# GITHUB_CLIENT_ID=ваш_id
# GITHUB_CLIENT_SECRET=ваш_секрет
